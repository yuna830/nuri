PRODUCT_LABEL_OCR_ENABLED=true
PRODUCT_LABEL_OCR_ALLOWED_SOURCES=GUARDIAN_WEB
DOCUMENT_AI_HISTORY_DB=document_ai_history.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://woori-link-react.vercel.app,https://woori-link-user.vercel.app

# 로컬 실행 시 Google Cloud 서비스 계정 JSON 파일 경로
# Render에서는 Secret File을 /etc/secrets/google-vision-service-account.json 으로 등록한 뒤 사용
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-vision-service-account.json
