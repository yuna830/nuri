```env
# Spring 백엔드 API
# API_BASE_URL=http://10.0.2.2:8080  (에뮬레이터)
API_BASE_URL=http://YOUR_SERVER_IP:8080
# 낙상 감지 서버
FALL_API_BASE_URL=http://YOUR_SERVER_IP:8000
# AI 복지 챗봇 서버 (ai_backend)
CHAT_API_BASE_URL=http://YOUR_SERVER_IP:8002
# 카카오 키
KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
```
